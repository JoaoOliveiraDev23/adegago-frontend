# Configuração do Firebase (Console do Firebase > Configurações do projeto > Seus apps > App da Web).
# Estes valores são IDENTIFICADORES PÚBLICOS do projeto, não são senhas. Mesmo assim, o arquivo
# .env não é versionado: cada pessoa/ambiente usa o seu.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Deixe false (ou ausente) no Firebase real. Para desenvolver com os emuladores locais use
# "npm run dev:emulador", que já carrega o arquivo .env.emulador.
VITE_USE_FIREBASE_EMULATORS=false
