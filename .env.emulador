# Usado por "npm run dev:emulador" (vite --mode emulador).
# São valores de DEMONSTRAÇÃO para os emuladores locais: não há nada secreto aqui, por isso este
# arquivo pode ser versionado. O ID "demo-adegago" garante que nenhum serviço real seja acessado.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-adegago.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-adegago
VITE_FIREBASE_APP_ID=demo-app-id
